---
import { featuredProjects, projectIndex } from '../data/projects';
import '../styles/global.css';

const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<script is:inline>document.documentElement.classList.add('js');</script>
		<title>Kenneth Staelens — Sport + Story</title>
		<meta name="description" content="Belgian graphic director and filmmaker creating visual stories across sport and culture." />
		<link rel="canonical" href={Astro.site} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Kenneth Staelens — Sport + Story" />
		<meta property="og:description" content="Belgian graphic director and filmmaker creating visual stories across sport and culture." />
		<meta property="og:url" content={Astro.site} />
		<meta property="og:image" content={new URL('/og-kenneth.jpg', Astro.site)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#f2f0eb" />
		{gaMeasurementId && (
			<>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
				<script define:vars={{ gaMeasurementId }} is:inline>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', gaMeasurementId);
				</script>
			</>
		)}
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="#top" aria-label="Kenneth Staelens home">KENNETH STAELENS</a>
			<button class="menu-button" aria-expanded="false" aria-controls="site-menu">Menu</button>
		</header>

		<div id="site-menu" class="menu-panel" aria-hidden="true" inert>
			<div class="menu-top">
				<span>KENNETH STAELENS</span>
				<button class="menu-close">Close</button>
			</div>
			<nav aria-label="Main navigation">
				<a href="#top"><span>Index</span><sup>01</sup></a>
				<a href="#work"><span>Selected work</span><sup>02</sup></a>
				<a href="#about"><span>About</span><sup>03</sup></a>
				<a href="#contact"><span>Contact</span><sup>04</sup></a>
			</nav>
			<div class="menu-foot"><span>Graphic director · Filmmaker</span><span>Belgium · Worldwide</span></div>
		</div>

		<main id="top">
			<section class="hero" aria-labelledby="hero-title">
				<p class="hero-kicker"><span>Independent portfolio · 2026</span><span>Belgium · Worldwide</span></p>
				<h1 id="hero-title"><span>Sport</span><span>+ Story</span></h1>
				<div class="hero-meta">
					<p>Creative direction · Film<br />Edit · Visual storytelling</p>
					<a href="#about">Meet Kenneth</a>
					<a class="down" href="#work" aria-label="Scroll to selected work">↓</a>
				</div>
			</section>

			<div class="ticker" aria-hidden="true">
				<div class="ticker-track">
					<span>Creative direction <i>✦</i> Film <i>✦</i> Sport <i>✦</i> Culture <i>✦</i> Editing <i>✦</i> Visual storytelling <i>✦</i></span>
					<span>Creative direction <i>✦</i> Film <i>✦</i> Sport <i>✦</i> Culture <i>✦</i> Editing <i>✦</i> Visual storytelling <i>✦</i></span>
				</div>
			</div>

			<section id="work" aria-labelledby="work-title">
				<div class="section-heading">
					<p>Selected work · 2026</p>
					<h2 id="work-title">Stories made to move at the speed of sport.</h2>
				</div>
				<div class="featured-grid">
					{featuredProjects.map((project, index) => (
						<a class="project-card" href={project.href} target="_blank" rel="noreferrer" data-reveal>
							<div class="video-wrap">
								<span class="project-number">0{index + 1}</span>
								<span class="project-arrow">View on Instagram ↗</span>
								<video autoplay muted loop playsinline preload="metadata" poster={project.poster} aria-label={`${project.title} project excerpt`}>
									<source src={project.video} type="video/mp4" />
								</video>
							</div>
							<div class="project-meta">
								<span>{project.title}</span>
								<span>{project.client}</span>
								<span>{project.year}</span>
								<span class="project-role">{project.role}</span>
							</div>
						</a>
					))}
				</div>
			</section>

			<section class="index" aria-labelledby="index-title">
				<div class="index-head"><span>Project index</span><h2 id="index-title">More work</h2></div>
				{projectIndex.map((project, index) => (
					<div class="index-row" data-reveal>
						<span>{String(index + 4).padStart(2, '0')}</span>
						<strong>{project.title}</strong>
						<span>{project.client}</span>
						<span>{project.role}</span>
					</div>
				))}
			</section>

			<section class="about" id="about" data-reveal>
				<p class="eyebrow">Profile</p>
				<h2>Kenneth Staelens is a Belgian graphic director and filmmaker working where sport, culture and emotion meet.</h2>
				<div class="about-grid">
					<p>At Sporthouse Group, Kenneth shapes visual stories across campaigns, premium productions and social-first content. His work spans creative direction, art direction, cinematography, editing and colour grading.</p>
					<p>Before moving behind the camera, Kenneth played football in Belgium and the Netherlands. That first-hand understanding of sport still informs how he sees movement, pressure and human stories.</p>
				</div>
				<a class="text-link" href="https://www.sporthousegroup.com/about" target="_blank" rel="noreferrer">View Sporthouse Group ↗</a>
			</section>
		</main>

		<footer id="contact">
			<div class="footer-top" data-reveal>
				<div class="contact-block"><span>Start a conversation</span><a href="https://www.sporthousegroup.com/" target="_blank" rel="noreferrer">via Sporthouse Group ↗</a></div>
				<nav aria-label="Footer navigation"><a href="#top">Index</a><a href="#work">Work</a><a href="#about">About</a><a href="#contact">Contact</a></nav>
				<div class="socials"><a href="https://www.instagram.com/sporthousegroup/" target="_blank" rel="noreferrer">Instagram</a><a href="https://www.linkedin.com/company/sporthouse-group" target="_blank" rel="noreferrer">LinkedIn</a><a href="https://www.sporthousegroup.com/" target="_blank" rel="noreferrer">Sporthouse</a></div>
			</div>
			<div class="footer-word" aria-hidden="true"><span>Sport</span><span>+ Story</span></div>
			<div class="footer-bottom"><span>© 2026 Kenneth Staelens</span><span>Belgium · Worldwide</span><a href="#top">Back to top ↑</a></div>
		</footer>

		<script>
			const panel = document.querySelector('.menu-panel');
			const openButton = document.querySelector('.menu-button');
			const closeButton = document.querySelector('.menu-close');
			const menuLinks = document.querySelectorAll('.menu-panel a');
			let lastFocused: Element | null = null;

			function setMenu(open: boolean) {
				panel?.classList.toggle('is-open', open);
				panel?.setAttribute('aria-hidden', String(!open));
				panel?.toggleAttribute('inert', !open);
				openButton?.setAttribute('aria-expanded', String(open));
				document.body.style.overflow = open ? 'hidden' : '';
				if (open) {
					lastFocused = document.activeElement;
					closeButton?.focus();
				} else if (lastFocused instanceof HTMLElement) {
					lastFocused.focus();
				}
			}

			openButton?.addEventListener('click', () => setMenu(true));
			closeButton?.addEventListener('click', () => setMenu(false));
			menuLinks.forEach((link) => link.addEventListener('click', () => setMenu(false)));
			document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenu(false); });

			const revealNodes = document.querySelectorAll('[data-reveal]');
			if ('IntersectionObserver' in window) {
				const observer = new IntersectionObserver(
					(entries) => entries.forEach((entry) => {
						if (entry.isIntersecting) entry.target.classList.add('is-visible');
					}),
					{ threshold: 0.1 },
				);
				revealNodes.forEach((node) => observer.observe(node));
			} else {
				revealNodes.forEach((node) => node.classList.add('is-visible'));
			}

			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.querySelectorAll('video').forEach((video) => video.pause());
			}
		</script>
	</body>
</html>
